<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="io.github.polestarcn.companion"/>
        <package android:name="com.heytap.mydevices"/>
        <package android:name="com.coloros.assistantscreen"/>
        <package android:name="com.oplus.pantanal.ums"/>
        <package android:name="com.heytap.speechassist"/>
        <package android:name="com.oplus.ocar"/>
    </queries>
    <application
        android:label="PsAssistant OPPO Bridge"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".BridgeDiagnosticsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
