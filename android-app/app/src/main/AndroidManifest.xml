            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <receiver android:name=".VehicleWidgetProvider" android:exported="true" android:icon="@mipmap/ic_launcher" android:label="@string/widget_standard_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_standard" />
        </receiver>
        <receiver android:name=".CompactWidgetProvider" android:exported="true" android:icon="@mipmap/ic_launcher" android:label="@string/widget_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_compact" />
        </receiver>
        <receiver android:name=".WideStripWidgetProvider" android:exported="true" android:icon="@mipmap/ic_launcher" android:label="@string/widget_wide_name">
