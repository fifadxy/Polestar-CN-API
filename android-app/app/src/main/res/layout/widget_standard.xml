<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
 <LinearLayout android:orientation="vertical" android:padding="14dp" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:id="@+id/widget_summary" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
   <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1B1B1B" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:text="PsAssistant"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="11dp">
     <TextView android:id="@+id/widget_soc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1B1B1B" android:textSize="39sp" android:textColor="#E76813" android:text="--%"/>
     <TextView android:id="@+id/widget_range" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1B1B1B" android:textSize="18sp" android:layout_marginLeft="18dp" android:text="-- km"/>
   </LinearLayout>
   <TextView android:id="@+id/widget_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1B1B1B" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" android:text="Status"/>
   <TextView android:id="@+id/widget_region" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1B1B1B" android:textSize="10sp" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" android:text="--"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="43dp">
   <TextView android:id="@+id/widget_action_lock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="43dp" android:gravity="center" android:padding="2dp" android:layout_marginRight="3dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_button" android:text="..."/>
   <TextView android:id="@+id/widget_action_climate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="43dp" android:gravity="center" android:padding="2dp" android:layout_marginRight="3dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_button" android:text="..."/>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
