<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="io.github.polestarcn.companion"/>
        <package android:name="com.heytap.mydevices"/>
        <package android:name="com.coloros.assistantscreen"/>
        <package android:name="com.oplus.pantanal.ums"/>
        <package android:name="com.heytap.speechassist"/>
        <package android:name="com.oplus.ocar"/>
    </queries>
    <application
        android:label="PsAssistant OPPO Bridge"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <provider
            android:name=".VehicleDeviceCardProvider"
            android:authorities="io.github.polestarcn.oppobridge.devices"
            android:exported="true"
            android:grantUriPermissions="false">
            <intent-filter>
                <action android:name="oplus.devicecards.action.DEVICE_INFO"/>
            </intent-filter>
            <meta-data android:name="oplus.devicecards.provider" android:resource="@xml/device_card"/>
        </provider>
        <activity
            android:name=".VehicleCardDetailActivity"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="com.oplus.mydevices.ACTION_DEVICE_DETAILED_PANEL"/>
                <action android:name="com.oplus.mydevices.ACTION_DEVICE_DETAILED_PAGE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".BridgeDiagnosticsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name="io.github.polestarcn.oppobridge.VehicleControlTileService"
            android:label="极星车控" android:icon="@drawable/ic_vehicle_card"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
    </application>
</manifest>
