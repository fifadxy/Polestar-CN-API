            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherRedDay" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_red_day" android:roundIcon="@mipmap/ic_launcher_red_day">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherRedNight" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:label="@string/app_name" android:icon="@mipmap/ic_launcher_red_night" android:roundIcon="@mipmap/ic_launcher_red_night">
