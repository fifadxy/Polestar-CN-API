# Safe-to-commit variable NAMES ONLY. Provide actual private values locally or through masked secrets.
# NEVER commit this completed file, the previous FULL APK, or the signing keystore.
PSA_PRIOR_PSASSISTANT_APK=/private/path/to/approved-PsAssistant-Standalone-FULL.apk
PSA_SIGNING_KEYSTORE=/private/path/to/authorized-release-signing.jks
PSA_SIGNING_STORE_PASSWORD=<LOCAL_SECRET_DO_NOT_COMMIT>
PSA_SIGNING_KEY_PASSWORD=<LOCAL_SECRET_DO_NOT_COMMIT>
PSA_SIGNING_KEY_ALIAS=androiddebugkey
# Optional approved private OPPO SDK artifacts belong under android-app/app/libs/ locally.
