<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY"
        android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
        android:layout_gravity="bottom" android:orientation="horizontal" android:baselineAligned="false"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="3dp">
        <FrameLayout android:id="@+id/volike_widget_lock"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground" android:contentDescription="Door lock">
            <ImageView android:id="@+id/volike_widget_lock_icon" android:layout_width="22dp"
                android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_lock" android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/volike_widget_climate"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground" android:contentDescription="Climate">
            <ImageView android:id="@+id/volike_widget_climate_icon" android:layout_width="22dp"
                android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_climate" android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/volike_widget_charge"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground" android:contentDescription="Charging details">
            <ImageView android:id="@+id/volike_widget_charge_icon" android:layout_width="22dp"
                android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_charge" android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/volike_widget_location"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground" android:contentDescription="Last parked location">
            <ImageView android:id="@+id/volike_widget_location_icon" android:layout_width="22dp"
                android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_location" android:contentDescription="@null"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>