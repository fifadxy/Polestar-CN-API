<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
 <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:padding="6dp" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:id="@+id/widget_summary" android:orientation="vertical" android:gravity="center_vertical" android:layout_width="0dp" android:layout_weight="0.16" android:layout_height="match_parent">
   <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" android:visibility="gone" android:ellipsize="end" android:text="PsAssistant"/>
   <TextView android:id="@+id/widget_soc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#E76813" android:text="--%" android:visibility="gone"/>
   <TextView android:id="@+id/widget_range" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:text="-- km" android:visibility="gone"/>
   <TextView android:id="@+id/widget_region" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:visibility="gone"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
    <TextView android:id="@+id/widget_action_lock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="43dp" android:gravity="center" android:padding="2dp" android:layout_marginRight="3dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_button" android:text="..."/>
    <TextView android:id="@+id/widget_action_climate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="43dp" android:gravity="center" android:padding="2dp" android:layout_marginRight="3dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_button" android:text="..."/>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
