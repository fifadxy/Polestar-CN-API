<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
<LinearLayout android:orientation="horizontal" android:padding="7dp" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/widget_summary" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
<TextView android:id="@+id/widget_title" android:fontFamily="@font/lato_bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="9sp" android:text="PsAssistant"/>
<LinearLayout android:id="@+id/widget_metric_row0" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="30dp"><TextView android:id="@+id/widget_metric0" style="@style/WidgetMetric"/><TextView android:id="@+id/widget_metric1" style="@style/WidgetMetric"/></LinearLayout>
<LinearLayout android:id="@+id/widget_metric_row1" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="30dp"><TextView android:id="@+id/widget_metric2" style="@style/WidgetMetric"/><TextView android:id="@+id/widget_metric3" style="@style/WidgetMetric"/></LinearLayout>
<TextView android:id="@+id/widget_region" android:fontFamily="@font/lato_regular" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textSize="7sp" android:text="更新 --"/>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:layout_width="92dp" android:layout_height="match_parent" android:gravity="center">
<TextView android:id="@+id/widget_action_lock" style="@style/WidgetAction" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginBottom="3dp" android:text="LOCK"/>
<TextView android:id="@+id/widget_action_climate" style="@style/WidgetAction" android:layout_width="match_parent" android:layout_height="34dp" android:text="CLIMATE"/>
</LinearLayout>
</LinearLayout></FrameLayout>